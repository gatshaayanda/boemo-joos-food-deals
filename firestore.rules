rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff', 'Owner', 'Staff'];
    }

    function validOrder() {
      // Every customer order must belong to a Firebase Auth session. Guests use Anonymous Auth; this is still authentication, not a sign-in requirement.
      return request.resource.data.keys().hasOnly([
          'customerId',
          'createdAt',
          'customerName',
          'phone',
          'mode',
          'scheduledFor',
          'deliveryLocation',
          'instructions',
          'items',
          'total',
          'status'
        ])
        && request.resource.data.keys().hasAll([
          'createdAt',
          'customerName',
          'phone',
          'mode',
          'scheduledFor',
          'deliveryLocation',
          'instructions',
          'items',
          'total',
          'status'
        ])
        && request.resource.data.createdAt is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.mode in ['pickup', 'delivery']
        && request.resource.data.scheduledFor is string
        && request.resource.data.deliveryLocation is string
        && request.resource.data.instructions is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'New'
        && (
          !request.resource.data.keys().hasAny(['customerId'])
          || request.resource.data.customerId is string
        );
    }

    function validCustomer(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'preferredDeliveryLocation',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.preferredDeliveryLocation is string
        && request.resource.data.notes is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function validReconciliation() {
      return request.resource.data.keys().hasOnly([
        'date',
        'actualCash',
        'actualETransfer',
        'actualOther',
        'notes',
        'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'date',
        'actualCash',
        'actualETransfer',
        'actualOther',
        'notes',
        'updatedAt'
      ])
      && request.resource.data.date is string
      && request.resource.data.actualCash is number
      && request.resource.data.actualCash >= 0
      && request.resource.data.actualETransfer is number
      && request.resource.data.actualETransfer >= 0
      && request.resource.data.actualOther is number
      && request.resource.data.actualOther >= 0
      && request.resource.data.notes is string
      && request.resource.data.updatedAt is string;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /customers/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validCustomer(uid);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if validOrder()
        && request.resource.data.keys().hasAll(['customerId'])
        && isOwner(request.resource.data.customerId);

      allow read: if isAdmin()
        || (
          resource.data.keys().hasAny(['customerId'])
          && isOwner(resource.data.customerId)
        );

      allow update, delete: if isAdmin();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notificationPreferences/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['enabled','leadMinutes','updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.leadMinutes in [5,10,15,20,30,45,60]
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
    }

    match /notificationTokens/{uid}/tokens/{tokenId} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['token','admin','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.admin is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
      allow read: if false;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.lastMessageAt is string
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.unreadForCustomer is bool
        && request.resource.data.unreadForAdmin is bool;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessageAt','lastMessagePreview','unreadForCustomer','unreadForAdmin','customerLastReadAt']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ['customer','admin']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string
          && (
            (request.resource.data.senderRole == 'customer' && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid)
            || (request.resource.data.senderRole == 'admin' && isAdmin())
          );
        allow update, delete: if false;
      }
    }

    match /dailyReconciliations/{date} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validReconciliation();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}